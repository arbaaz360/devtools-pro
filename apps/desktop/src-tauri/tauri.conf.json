{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The DevTools Pro",
  "version": "0.1.0",
  "identifier": "com.thedevtoolspro.workbench",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "The DevTools Pro · Native preview",
      "width": 1280,
      "height": 840,
      "minWidth": 800,
      "minHeight": 560,
      "backgroundColor": "#111419"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
