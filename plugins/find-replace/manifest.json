{
  "kind": "pluginManifest",
  "apiVersion": "devtools.plugin/v2",
  "id": "text.find-replace",
  "version": "0.2.0",
  "stateVersion": 1,
  "title": "Find & Replace",
  "description": "Literal Unicode find and replace.",
  "tools": [
    {"id":"text.find-replace","title":"Find & Replace","category":"text","operationIds":["text.find-replace"],"workspaceId":"find-replace"}
  ],
  "operations": [
    {
      "id":"text.find-replace",
      "title":"Find and replace",
      "executor":{"kind":"javascriptWorker","id":"text.find-replace.processor","version":"0.2.0","engine":"ecmascript","engineVersion":"2024","syntax":"literal","cancellation":"cooperative"},
      "inputs":[{"id":"input","kind":"document","required":true,"multiplicity":"one","contentKinds":["text"]}],
      "outputs":[{"id":"output","kind":"report","multiplicity":"one","representations":["text","code","properties"],"language":"json","sensitive":false,"exports":["copyText","save","useAsInput"]}],
      "options":[
        {"id":"query","type":"string","label":"Find","default":"","maxLength":"1048576","persistence":"instance","sensitive":false},
        {"id":"replacement","type":"string","label":"Replace","default":"","maxLength":"1048576","persistence":"instance","sensitive":false},
        {"id":"mode","type":"enum","label":"Mode","default":"find","choices":[{"id":"find","label":"Find"},{"id":"replace","label":"Replace first"},{"id":"replaceAll","label":"Replace all"}],"persistence":"instance","sensitive":false},
        {"id":"case-sensitive","type":"boolean","label":"Match case","default":true,"persistence":"instance","sensitive":false},
        {"id":"whole-word","type":"boolean","label":"Whole word","default":false,"persistence":"instance","sensitive":false}
      ],
      "trigger":{"modes":["explicit","inputChange"],"debounceMs":"100"},
      "limits":{"maxInputBytes":"1048576","maxOutputBytes":"4194304","maxChunkBytes":"4194304","deadlineMs":"2000","maxRows":"10000"}
    }
  ],
  "workspaces": [
    {"id":"find-replace","kind":"transform","bindings":[],"commands":[],"presentationSettings":[]}
  ],
