  "operations": [{
    "id":"text.lines",
    "title":"Line Tools",
    "executor":{"kind":"javascriptWorker","id":"text.lines.processor","version":"0.1.0","engine":"node","engineVersion":"20","syntax":"javascript","cancellation":"cooperative"},
    "inputs":[{"id":"input","label":"Text","kind":"document","required":true,"multiplicity":"one","contentKinds":["text"]}],
    "outputs":[{"id":"output","label":"Result","kind":"value","multiplicity":"one","mime":["text/plain"],"representations":["text","properties"],"sensitive":false,"exports":["copyText","save"]}],
    "options":[
