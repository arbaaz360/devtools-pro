        "id": "text.escaping.processor",
        "version": "0.2.0",
        "engine": "ecmascript",
        "engineVersion": "2024",
        "syntax": "backslash",
        "cancellation": "cooperative"
      },
      "inputs": [
        {
          "id": "input",
          "kind": "document",
          "required": true,
          "multiplicity": "one",
          "contentKinds": [
