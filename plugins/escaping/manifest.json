            },
            {
              "id": "unescape",
              "label": "Unescape"
            }
          ],
          "persistence": "instance",
          "sensitive": false
        },
        {
          "id": "quotes",
          "type": "enum",
          "label": "Escape quotes",
          "default": "both",
          "choices": [
            {
              "id": "both",
              "label": "Double and single"
            },
            {
              "id": "double",
              "label": "Double only"
            },
            {
              "id": "single",
              "label": "Single only"
            },
            {
              "id": "none",
              "label": "Neither"
            }
          ],
          "persistence": "instance",
          "sensitive": false,
          "group": "Escape",
          "rules": [
            {
              "effect": "visible",
              "when": {
                "kind": "predicate",
                "optionId": "mode",
                "operator": "equals",
                "value": "escape"
              }
            }
          ]
        },
        {
          "id": "non-ascii",
          "type": "enum",
          "label": "Non-ASCII characters",
          "default": "keep",
          "choices": [
            {
              "id": "keep",
              "label": "Keep literal"
            },
            {
              "id": "unicode",
              "label": "\\uHHHH and \\u{H...}"
            },
            {
              "id": "utf16",
              "label": "\\uHHHH code units"
            }
          ],
          "persistence": "instance",
          "sensitive": false,
          "group": "Escape",
          "rules": [
