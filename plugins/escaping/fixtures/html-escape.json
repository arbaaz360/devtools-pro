[
  {
    "name": "unsafe symbols use named references",
    "operationId": "text.html",
    "options": {
      "mode": "escape"
    },
    "input": "<a href=\"x\">Tom & Jerry's</a>",
    "output": "&lt;a href=&quot;x&quot;&gt;Tom &amp; Jerry&apos;s&lt;/a&gt;",
    "value": {
      "sequences": 8
    }
  },
  {
    "name": "unsafe symbols decimal",
    "operationId": "text.html",
    "options": {
      "mode": "escape",
      "prefer-named": false
    },
    "input": "<a href=\"x\">Tom & Jerry's</a>",
    "output": "&#60;a href=&#34;x&#34;&#62;Tom &#38; Jerry&#39;s&#60;/a&#62;"
  },
  {
    "name": "unsafe symbols hexadecimal",
    "operationId": "text.html",
