    "input": "<a href=\"x\">Tom & Jerry's</a>",
    "output": "&#x3C;a href=&#x22;x&#x22;&#x3E;Tom &#x26; Jerry&#x27;s&#x3C;/a&#x3E;"
  },
  {
    "name": "latin-1 and symbol names",
    "operationId": "text.html",
    "options": {
      "mode": "escape"
    },
    "input": "café © 5 ≤ 6 … € ×",
    "output": "caf&eacute; &copy; 5 &le; 6 &hellip; &euro; &times;",
    "value": {
      "sequences": 6
    }
  },
  {
    "name": "non-ascii decimal",
    "operationId": "text.html",
    "options": {
      "mode": "escape",
      "prefer-named": false
